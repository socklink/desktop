{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SockLink",
  "version": "1.0.1",
  "identifier": "com.adhil.pzync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SockLink",
        "label": "main",
        "width": 400,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:40001; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "resources": {
      "resources/obs-virtualcam-module64.dll": "obs-virtualcam-module64.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "scrot",
          "xdotool",
          "wmctrl",
          "flameshot",
          "v4l-utils",
          "v4l2loopback-dkms",
          "pulseaudio-utils"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNjE5RENGMDc5OUZEQjUKUldTMS9aa0h6NTFoUWQ5Z1lkQmNranZKRUhpd1ZHcnNrdEw3eGY3ZTNjTmVONnJhWDgrd2FCRy8K",
      "endpoints": [
        "https://raw.githubusercontent.com/pzynk/desktop/refs/heads/main/release/latest.json"
      ]
    }
  }
}